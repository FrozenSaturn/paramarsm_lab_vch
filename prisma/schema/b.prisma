// OWNER: Person B. References to A's tables are plain uuid columns with NO Prisma relation, so
// A's model file never needs a back-relation from B. Integrity is checked in code; add indexes here.
model extracted_fields {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type  String
  entity_id    String    @db.Uuid
  field        String
  value        Json?
  document_id  String?   @db.Uuid
  page         Int?
  snippet      String?
  confidence   Decimal?
  confirmed_by String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  @@index([entity_type, entity_id])
  @@index([document_id])
}

model doc_chunks {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String?  @db.Uuid
  message_id  String?  @db.Uuid
  case_id     String?  @db.Uuid
  page        Int?
  content     String
  embedding   Unsupported("vector(384)")?
  @@index([case_id])
  @@index([document_id])
}

model vendor_performance {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id         String    @db.Uuid
  case_id           String?   @db.Uuid
  quality           Int?
  timeliness        Int?
  disputes          Int?
  safety            Int?
  note              String?
  source_message_id String?   @db.Uuid
  confirmed_by      String?   @db.Uuid
  is_demo           Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  @@index([vendor_id])
}

model memory_refs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mem0_id    String
  entity     String
  message_id String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  @@index([entity])
}

model quotes {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id        String    @db.Uuid
  rfq_id         String?   @db.Uuid
  vendor_id      String    @db.Uuid
  document_id    String?   @db.Uuid
  version        Int?      @default(1)
  quote_date     DateTime? @db.Date
  reference      String?
  validity       String?
  gst_treatment  String?
  freight        String?
  payment_terms  String?
  advance        String?
  completion_time String?
  warranty       String?
  status         String?   @default("extracting") // extracting|needs_review|ready|failed|superseded (CHECK in raw SQL)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  // W5 quote detail (B, stage 1-2). Printed by the vendor and read by the model, or computed by code.
  gstin            String?
  security_deposit String?
  pf_esi           String?
  mobilisation     String?
  exclusions       String?
  validity_days    Int?
  valid_until      DateTime? @db.Date
  gst_rate         Decimal?
  vendor_total     Decimal?  // sum of the vendor's own quantity x rate (computed)
  stated_total     Decimal?  // grand total as printed, if any
  total_on_boq     Decimal?  // sum of vendor rate x Vinayak quantity over comparable lines (computed)
  comparable_lines Int?
  scope            String?   // matches|close|different|unknown (CHECK in raw SQL)
  flags            Json      @default("[]")
  needs_review     Boolean   @default(false)
  review_reasons   Json      @default("[]")
  conditions       Json      @default("[]")
  extraction       Json?     // the model's raw reading, never edited, so everything can be re-derived
  second_read      Json?     // independent second read of handwritten rates
  confirmations    Json      @default("{}") // values a person confirmed or corrected, laid over extraction
  model            String?
  prompt_version   String?
  error            String?
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  lines          quote_lines[]
  terms          quote_terms[]
  @@index([case_id])
  @@index([document_id])
  @@unique([case_id, vendor_id, version])
}

model quote_lines {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id        String   @db.Uuid
  boq_line_id     String?  @db.Uuid
  unit            String?
  quantity        Decimal?
  rate            Decimal?
  amount          Decimal?
  make            String?
  normalized_rate Decimal?
  flags           Json?    @default("[]")
  quote           quotes   @relation(fields: [quote_id], references: [id])
  // W5 line detail (B, stage 1-2)
  serial           String?
  item             String?
  unit_raw         String?
  amount_stated    Decimal?  // as printed; null if the vendor printed none
  amount_computed  Decimal?  // vendor quantity x vendor rate
  normalized_unit  String?   // SQM for area, RMT for length
  boq_unit         String?
  boq_quantity     Decimal?  // Vinayak's quantity in the BOQ's unit
  amount_on_boq    Decimal?  // vendor rate x Vinayak quantity; null when not comparable
  qty_ratio        Decimal?
  rate_handwritten Boolean   @default(false)
  page             Int?
  confidence       Decimal?
  position         Int?
  @@index([quote_id, position])
  @@index([boq_line_id])
}

model quote_terms {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id String  @db.Uuid
  term     String
  status   String  // met|not_met|not_stated (CHECK in raw SQL)
  detail   String?
  quote    quotes  @relation(fields: [quote_id], references: [id])
  @@unique([quote_id, term])
}

model comparatives {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id    String    @db.Uuid
  version    Int
  matrix     Json
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  // W6 (B, stage 3). Everything needed to re-derive the numbers is kept on the row.
  rfq_id      String?  @db.Uuid
  quote_ids   Json     @default("[]")  // the quote versions that went in
  weights     Json?                     // the weights used for this version's scores
  category    String?                   // weights category, e.g. "waterproofing" or "default"
  inputs_hash String?                   // sha256 of the canonical inputs; same hash gives the same numbers
  trigger     String?                   // button|all_quoted|due_date|revised_quote|script
  created_by  String?                   // user id, or the workflow name
  scores           scores[]
  recommendations  recommendations[]
  @@unique([case_id, version])
}

model scores {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comparative_id String   @db.Uuid
  vendor_id      String   @db.Uuid
  total          Decimal?
  breakdown      Json?
  flags          Json?
  rank           Int?     // 1 = top on the stored weights (B, stage 3)
  comparative    comparatives @relation(fields: [comparative_id], references: [id])
  @@index([comparative_id])
}

/// Scoring weights per work category (PLAN.md section 7.4). The HOD edits them; "default" is the fallback.
model scoring_weights {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category   String   @unique
  weights    Json     // { price, past_performance, delivery_fit, compliance, responsiveness, commercial }, sum 100
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model recommendations {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comparative_id String    @db.Uuid
  ranking        Json?
  explanation    Json?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  // Stage 4 (B): the packet the HOD decides on.
  case_id          String?   @db.Uuid
  status           String    @default("draft") // draft|with_hod|decided|sent_back|superseded (CHECK in raw SQL)
  top_vendor_id    String?   @db.Uuid
  facts            Json?     // the computed facts the explanation was written from, with proof ids
  model            String?
  prompt_version   String?
  notify_action_id String?   @db.Uuid
  sent_at          DateTime? @db.Timestamptz(6)
  created_by       String?
  comparative    comparatives @relation(fields: [comparative_id], references: [id])
  decisions      decisions[]
  @@index([comparative_id])
}

model decisions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id String    @db.Uuid
  vendor_id         String?   @db.Uuid // null when the HOD sends the packet back
  decided_by        String    @db.Uuid
  overridden        Boolean?  @default(false)
  reason            String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  // Stage 4 (B)
  case_id           String?   @db.Uuid
  kind              String    @default("approve") // approve|override|send_back (CHECK in raw SQL)
  top_vendor_id     String?   @db.Uuid
  weights           Json?     // weights on screen when the HOD decided ("what if" view), for the record only
  recommendation    recommendations @relation(fields: [recommendation_id], references: [id])
  @@index([recommendation_id])
  @@index([case_id])
}
