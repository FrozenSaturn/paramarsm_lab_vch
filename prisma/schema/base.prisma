// Shared. Frozen after Day 0 (changes need both builders' approval).
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, pgcrypto]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum app_role_t {
  contracts_engineer
  hod
  site_engineer
  management
  admin
}
