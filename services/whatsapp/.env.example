# Copy to .env. Make each secret with: openssl rand -hex 24
EVOLUTION_API_KEY=
BRIDGE_TOKEN=
WEBHOOK_SECRET=

# Host ports. Both bind to 127.0.0.1 only.
EVOLUTION_PORT=8080
BRIDGE_PORT=8091

# The default instance for the CLI and the link page. One instance is one linked phone.
INSTANCE_NAME=vch-main

# Optional. The backend URL that gets each new message as JSON. Empty means store only.
FORWARD_URL=
FORWARD_TOKEN=

# Optional. Comma-separated numbers with country code. Empty means all direct and group chats.
ALLOW_NUMBERS=
