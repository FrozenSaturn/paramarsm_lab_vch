{
  "name": "vinayak-procurement-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "inngest": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset && prisma migrate deploy",
    "seed": "tsx scripts/seed/index.ts",
    "db:migrate": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "test": "tsx --test 'src/**/*.test.ts'",
    "seed:b-dev": "tsx --env-file=.env scripts/seed/b/dev-fixtures.ts",
    "eval:read": "tsx --env-file=.env scripts/b/eval-read.ts",
    "compare:run": "tsx --env-file=.env scripts/b/run-compare.ts",
    "recommend:run": "tsx --env-file=.env scripts/b/run-recommend.ts",
    "seed:b-memories": "tsx --env-file=.env scripts/seed/b/memories.ts",
    "index:docs": "tsx --env-file=.env scripts/b/index-docs.ts",
    "eval:search": "tsx --env-file=.env scripts/b/eval-search.ts",
    "seed:b-performance": "tsx --env-file=.env scripts/seed/b/performance.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@googleapis/gmail": "^22.1.0",
    "@huggingface/transformers": "^4.3.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.3.4",
    "inngest": "^4.26.2",
    "mailparser": "^3.15.0",
    "mem0ai": "^3.3.1",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "prisma": {
    "schema": "prisma/schema"
  }
}
