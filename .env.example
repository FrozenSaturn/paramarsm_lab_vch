# ---- shared ----
# Prisma Migrate (local Supabase Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ---- A ----
# Who may sign in: comma list of email:role (roles: contracts_engineer, hod, site_engineer, management, admin)
SEED_USERS=
# The one inbox that plays every vendor; seed creates name+bajrang@gmail.com style plus-addresses
VENDOR_MAILBOX=
# Set true to seed without computing embeddings
SKIP_EMBED=false
RUN_INGEST=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WEBHOOK_TOKEN=
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
# Item-code judge. CODE_JUDGE=rules turns the model off.
CODE_JUDGE=
CODE_JUDGE_MODEL=claude-sonnet-5-5
# Tender (W3/W4)
RFQ_CC=
RFQ_SENDER=Contracts & Planning, Vinayak Group
REMINDER_AFTER_MINUTES=
# true: do everything except the Gmail call. For tests and demos only.
MAIL_DRY_RUN=false
# Triage model (W0)
TRIAGE_MODEL=claude-haiku-5-5
# WhatsApp bridge (services/whatsapp). The tokens must equal BRIDGE_TOKEN and FORWARD_TOKEN in services/whatsapp/.env
WHATSAPP_BRIDGE_URL=http://127.0.0.1:8091
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_FORWARD_TOKEN=
WHATSAPP_INSTANCE=vch-main
# Extra allowed numbers, digits with country code, comma separated. Site people and vendors come from the database.
WHATSAPP_ALLOW_NUMBERS=
WHATSAPP_MAX_PER_HOUR=20
# Seed phone numbers: SEED_PEOPLE_PHONES="Arijit Dey:919800000001"  SEED_VENDOR_PHONES="bajrang:919800000002"
SEED_PEOPLE_PHONES=
SEED_VENDOR_PHONES=
# ---- B ----
MEM0_API_KEY=
# Only messages from these senders go to the mem0 cloud (comma-separated emails or phones).
# Use only addresses that send demo-written text. Empty = nothing goes to mem0 ("skipped: sender not on allow-list").
MEM0_SENDER_ALLOWLIST=
# Email "From" can be forged: email senders reach mem0 only when this is true (demo mailbox only).
MEM0_ALLOW_EMAIL=false
# Stops the mem0 client from sending usage telemetry to a third party (src/memory sets it too)
MEM0_TELEMETRY=false
# Model that reads a memory for vendor performance (default claude-opus-5-5)
PERFORMANCE_MODEL=
# Quote reading (W5). Uses ANTHROPIC_API_KEY above.
QUOTE_MODEL=claude-opus-5-5
# Dev only: "fixture" reads the four sample quotes from fixtures/quotes.json instead of calling the model
QUOTE_READER=
# Storage bucket holding documents.storage_path (temporary until A's storage helper lands)
STORAGE_BUCKET=documents
# Set to true once A's emit() also dispatches to Inngest, so B's events are not sent twice
EMIT_DISPATCHES_TO_INNGEST=false

# B: show /dev/quotes (Comparative + Recommendation panels) in a production build, e.g. the demo server.
ENABLE_DEV_PAGES=false
SERVER_ACTIONS_ALLOWED_ORIGINS=
