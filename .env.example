# Evolution API (docker compose)
EVO_URL=http://localhost:8080
EVO_API_KEY=change-me-long-random
EVO_INSTANCE=vinayak
# Number that is linked to Evolution API (digits only, with country code)
WA_NUMBER=
# Only these sender numbers are processed (comma separated, full digits incl. country code, e.g. 919876543210).
# Empty = nobody is processed.
ALLOWED_SENDERS=
# Claude, used to normalise quotes and read scanned PDFs / images
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Local Whisper model (runs offline after first download)
WHISPER_MODEL=Xenova/whisper-small
PORT=3000
HOST=127.0.0.1
# Shared secret Evolution API must send in the x-webhook-token header on webhook calls (use a long random string)
WEBHOOK_SECRET=
# Bearer token for GET /quotes (endpoint is disabled if empty)
ADMIN_TOKEN=
